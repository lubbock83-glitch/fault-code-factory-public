# ---------------------------------------------------------------------------
# Fault Code Factory - copy to .env and fill in. .env is gitignored.
#
# Every credential AND every project identifier lives here. Nothing is
# hardcoded in src/, which is what makes this tree safe to publish.
# ---------------------------------------------------------------------------

# --- Anthropic -------------------------------------------------------------
ANTHROPIC_API_KEY=

# Per-agent model override. Defaults to claude-opus-5 when unset.
# The auditor is the provenance gate - do not downgrade it to save money.
MODEL_RESEARCHER=claude-opus-5
MODEL_WRITER=claude-opus-5
MODEL_EDITOR=claude-opus-5
MODEL_AUDITOR=claude-opus-5

# --- Supabase (data plane) -------------------------------------------------
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# --- Trigger.dev -----------------------------------------------------------
TRIGGER_PROJECT_REF=
TRIGGER_SECRET_KEY=
TRIGGER_API_URL=https://api.trigger.dev

# --- Webflow ---------------------------------------------------------------
WEBFLOW_TOKEN=
WEBFLOW_SITE_ID=
WEBFLOW_COLLECTION_FAULT_CODES=
WEBFLOW_COLLECTION_HARDWARE=
WEBFLOW_COLLECTION_TAXONOMY=

# --- Site ---
# Used for canonical URLs in generated JSON-LD.
PUBLIC_SITE_URL=
